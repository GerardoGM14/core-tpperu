---
// ============================================================
//  Footer — pie de página reutilizable (node 309:7302)
//  Incluye: banner verde "Las mejores experiencias" + footer completo
//  (marca/redes, contacto, newsletter, pagos, reclamaciones, términos).
//  Trae su propio fondo cascada + degradado oscuro.
//
//  Slot por defecto: contenido opcional que se renderiza ARRIBA del banner,
//  apoyado sobre la misma cascada del footer. En el index se usa para meter
//  el <ContactForm withBackground={false} />. En Nosotros se deja vacío.
// ============================================================
import { Image } from 'astro:assets';
import contactoBg from '../assets/contacto-bg.png';
import hojaIzq from '../assets/hoja-izq.svg';
import logoTppFooter from '../assets/logo-tpp-footer.png';
import libroReclamaciones from '../assets/libro-reclamaciones.png';
import pagoVisa from '../assets/pago-visa.png';
import pagoMaster from '../assets/pago-master.png';
import pago3 from '../assets/pago-3.png';

// ¿Hay contenido en el slot por defecto? (para ajustar el padding superior)
const hasSlot = Astro.slots.has('default');
---

<footer class:list={["relative overflow-hidden bg-[#191505] pb-[65px] px-8 lg:px-[100px]", hasSlot ? 'pt-[120px]' : 'pt-[80px]']}>
	{/* Fondo: imagen cascada + degradado oscuro */}
	<div aria-hidden="true" class="absolute inset-0 pointer-events-none z-0">
		<Image src={contactoBg} alt="" class="absolute top-0 left-0 w-full h-[81%] object-cover" />
		<div class="absolute inset-0 bg-gradient-to-b from-[rgba(25,21,5,0.81)] from-[19%] to-[#191505] to-[79%]"></div>
	</div>

	<div class="relative z-10 flex flex-col gap-[61px] items-center w-full max-w-[1312px] mx-auto">

		{/* Slot opcional: ContactForm en el index */}
		<slot />

		{/* === Banner verde === */}
		<div class="relative bg-[#5b6d12] rounded-xl flex flex-col gap-3.5 items-center justify-center text-center px-8 py-[30px] w-full overflow-hidden">
			{/* Hojas decorativas en las esquinas. La derecha es espejo de la izquierda. */}
			<img src={hojaIzq.src} alt="" aria-hidden="true" class="pointer-events-none select-none absolute left-0 top-0 h-full w-auto z-0 opacity-50" />
			<img src={hojaIzq.src} alt="" aria-hidden="true" class="pointer-events-none select-none absolute right-0 top-0 h-full w-auto z-0 opacity-50 -scale-x-100" />

			<div class="relative z-10 flex flex-col gap-1 items-center leading-[0.95]">
				<div class="flex flex-wrap gap-x-3.5 items-center justify-center">
					<span class="font-heading font-bold text-[24px] text-white">Las</span>
					<span class="font-decoration text-[32px] text-[#b8e230]">mejores experiencias</span>
				</div>
				<p class="font-heading font-bold text-[24px] text-white">están más cerca de lo que imaginas</p>
			</div>
			<p class="relative z-10 font-body text-[18px] text-[#dfdfdf]/80 text-center">
				Esperamos ayudarte a vivir una experiencia inolvidable en Tarapoto.
			</p>
		</div>

		{/* === Footer === */}
		<div class="flex flex-col gap-8 w-full">
			<div class="flex flex-col lg:flex-row gap-10 lg:gap-8 items-start justify-between pb-10 w-full">
				{/* Marca + redes */}
				<div class="flex flex-col gap-4 items-start">
					<Image src={logoTppFooter} alt="TPP Perú" class="w-[160px] brightness-0 invert" />
					<p class="font-body text-[16px] text-[#f3f2ed]/80">TPP PERU SAC - RUC: 20609758199</p>
					<div class="flex gap-[17px] items-center mt-1">
						{/* Facebook */}
						<a href="#" aria-label="Facebook" class="size-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="#f3f2ed"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
						</a>
						{/* TikTok */}
						<a href="#" aria-label="TikTok" class="size-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="#f3f2ed"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64c.298 0 .595.045.88.135V9.4a6.33 6.33 0 00-1-.05A6.34 6.34 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.04-.1z"/></svg>
						</a>
						{/* Instagram */}
						<a href="#" aria-label="Instagram" class="size-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07c-4.35.2-6.78 2.62-6.98 6.98C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8zm6.41-10.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z" fill="#f3f2ed"/></svg>
						</a>
					</div>
				</div>

				{/* Contacto */}
				<div class="flex flex-col gap-[19px] items-start">
					<div class="flex flex-col gap-3">
						<div class="flex gap-3 items-center">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 16.92z" stroke="#f4b13b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
							<span class="font-body text-[16px] text-[#f3f2ed]">933 255 002</span>
						</div>
						<div class="flex gap-3 items-center">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z" stroke="#f4b13b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 6l-10 7L2 6" stroke="#f4b13b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
							<span class="font-body text-[16px] text-[#f3f2ed]">info@tarapototours.com</span>
						</div>
						<div class="flex gap-3 items-center">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="#f4b13b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3" stroke="#f4b13b" stroke-width="2"/></svg>
							<span class="font-body text-[16px] text-[#f3f2ed]">Jr. Lamas 165B - Tarapoto</span>
						</div>
					</div>
					{/* Atención 24/7 badge */}
					<div class="bg-[#f26304] rounded px-3.5 py-2 flex gap-1.5 items-end">
						<span class="font-heading font-semibold text-[14px] text-white">Atención 24/7:</span>
						<span class="font-heading font-bold text-[18px] text-white leading-none">948 461 653</span>
					</div>
				</div>

				{/* Newsletter */}
				<div class="flex flex-col gap-[18px] items-start w-full lg:w-[384px]">
					<div class="flex flex-col gap-4 text-[#f3f2ed]">
						<p class="font-heading font-bold text-[18px]">Suscríbete a nuestro Newsletter</p>
						<p class="font-body text-[16px]">Tu próximo viaje puede empezar aquí. Suscríbete y descubre mucho más...</p>
					</div>
					<form class="flex w-full">
						<input type="email" placeholder="Correo Electrónico" class="flex-1 min-w-0 h-11 px-[18px] py-2.5 rounded-l bg-[#383313]/50 border border-[#383313] text-white text-[16px] placeholder:text-[#63605b] focus:border-[#f4b13b] outline-none transition-colors" />
						<button type="submit" class="shrink-0 h-11 px-6 rounded-r bg-[#f4b13b] hover:brightness-105 transition-all font-action font-medium text-[16px] text-[#121110] cursor-pointer">Suscríbete</button>
					</form>
					<label class="flex gap-2.5 items-center cursor-pointer">
						<span class="size-5 rounded bg-[#f4b13b] flex items-center justify-center shrink-0">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#121110" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
						<span class="font-body text-[16px] text-[#f3f2ed]">Acepto las políticas de Privacidad</span>
					</label>
				</div>
			</div>

			{/* Línea divisoria */}
			<div class="w-full h-px bg-white/15"></div>

			{/* Pagos + reclamaciones + términos */}
			<div class="flex flex-col lg:flex-row gap-6 items-center justify-between w-full">
				{/* Métodos de pago */}
				<div class="flex gap-5 items-center">
					<Image src={pagoVisa} alt="Visa" class="h-[42px] w-[73px] object-contain rounded-[5px]" />
					<Image src={pagoMaster} alt="Mastercard" class="h-[42px] w-[73px] object-contain rounded-[5px]" />
					<Image src={pago3} alt="Método de pago" class="h-[42px] w-[73px] object-contain rounded-[5px]" />
				</div>
				{/* Libro de reclamaciones */}
				<Image src={libroReclamaciones} alt="Libro de reclamaciones" class="h-[48px] w-auto object-contain" />
				{/* Términos + copyright */}
				<div class="flex flex-col gap-4 items-center lg:items-end text-[#f3f2ed]">
					<div class="flex gap-10 text-[16px]">
						<a href="#" class="hover:underline">Términos y condiciones</a>
						<a href="#" class="hover:underline">Políticas de Privacidad</a>
					</div>
					<p class="font-body text-[12px]">© 2026 TTP Perú Tarapoto. Todos los derechos reservados.</p>
				</div>
			</div>
		</div>
	</div>
</footer>
