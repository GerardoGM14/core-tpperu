	{/* Carruseles: finito (flechas con límites) e infinito (loop sin fin con clones) */}
	<script>
		// Distancia entre dos cards consecutivas (ancho + gap), medida del DOM
		function stepOf(el: HTMLElement) {
			const cards = el.querySelectorAll('article');
			if (cards.length >= 2) {
				return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
			}
			return cards[0] ? cards[0].getBoundingClientRect().width + 24 : 272;
		}

		// ---- Carrusel finito: flechas con scroll suave, deshabilitadas en extremos ----
		document.querySelectorAll('[data-carousel-track]:not([data-carousel-infinite])').forEach((track) => {
			const el = track as HTMLElement;
			const wrap = el.parentElement!;
			const prev = wrap.querySelector('[data-carousel-prev]') as HTMLButtonElement;
			const next = wrap.querySelector('[data-carousel-next]') as HTMLButtonElement;
			const update = () => {
				const max = el.scrollWidth - el.clientWidth - 1;
				prev.disabled = el.scrollLeft <= 0;
				next.disabled = el.scrollLeft >= max;
			};
			prev?.addEventListener('click', () => el.scrollBy({ left: -stepOf(el), behavior: 'smooth' }));
			next?.addEventListener('click', () => el.scrollBy({ left: stepOf(el), behavior: 'smooth' }));
			el.addEventListener('scroll', update, { passive: true });
			window.addEventListener('resize', update);
			update();
		});

		// ---- Carrusel infinito: clona el set de cards a ambos lados y salta sin costuras ----
		document.querySelectorAll('[data-carousel-infinite]').forEach((track) => {
			const el = track as HTMLElement;
			const wrap = el.parentElement!;
			const prev = wrap.querySelector('[data-carousel-prev]') as HTMLButtonElement;
			const next = wrap.querySelector('[data-carousel-next]') as HTMLButtonElement;

			const originals = Array.from(el.children) as HTMLElement[];
			const setCount = originals.length;
			if (setCount === 0) return;

			// Clonar el set completo antes y después (marcados como clones para no duplicar listeners)
			const head = originals.map((c) => c.cloneNode(true) as HTMLElement);
			const tail = originals.map((c) => c.cloneNode(true) as HTMLElement);
			head.forEach((c) => { c.setAttribute('aria-hidden', 'true'); el.insertBefore(c, el.firstChild); });
			tail.forEach((c) => { c.setAttribute('aria-hidden', 'true'); el.appendChild(c); });

			// Ancho de un set completo (para posicionar y para los saltos)
			const setWidth = () => stepOf(el) * setCount;

			// Arrancar posicionado en el set "real" del medio
			let ready = false;
			const init = () => {
				el.scrollLeft = setWidth();
				ready = true;
			};
			// Esperar a que las imágenes midan bien
			requestAnimationFrame(() => requestAnimationFrame(init));

			// Salto invisible: si entras en la zona de clones, reposiciona al set real equivalente
			let ticking = false;
			el.addEventListener('scroll', () => {
				if (!ready || ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const w = setWidth();
					if (el.scrollLeft < w * 0.5) {
						el.scrollLeft += w;
					} else if (el.scrollLeft >= w * 1.5) {
						el.scrollLeft -= w;
					}
					ticking = false;
				});
			}, { passive: true });

			prev?.addEventListener('click', () => el.scrollBy({ left: -stepOf(el), behavior: 'smooth' }));
			next?.addEventListener('click', () => el.scrollBy({ left: stepOf(el), behavior: 'smooth' }));
			window.addEventListener('resize', () => { if (ready) el.scrollLeft = setWidth() + (el.scrollLeft % setWidth()); });
		});
	</script>
