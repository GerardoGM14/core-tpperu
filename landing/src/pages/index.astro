---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Text from '../components/Text.astro';
import { Image } from 'astro:assets';
import backgroundHero from '../assets/background.webp';
import backgroundPromo from '../assets/background-promo.webp';
import wspIcon from '../icons/icon-wsp.svg';
import logoMarca from '../assets/logo_tpperu.png';

// ============================================================
const paquetes = [
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Imperdibles',
		tagClase: 'bg-[#f26304] text-white',
		imagen: 'https://images.unsplash.com/photo-1531168556467-80aace0d0144?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Nuevo',
		tagClase: 'bg-[#f4b13b] text-[#121110]',
		imagen: 'https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Cyber',
		tagClase: 'bg-[#cc140d] text-white',
		imagen: 'https://images.unsplash.com/photo-1437846972679-9e6e537be46e?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Imperdibles',
		tagClase: 'bg-[#f26304] text-white',
		imagen: 'https://images.unsplash.com/photo-1518182170546-07661fd94144?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Nuevo',
		tagClase: 'bg-[#f4b13b] text-[#121110]',
		imagen: 'https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=500&q=80',
	},
];
---

<Layout title="TPP PERÚ | Vive Tarapoto">
	<Navbar />
	
	<main class="relative h-screen min-h-[800px] overflow-hidden">
		{/* Imagen de fondo con overlay */}
		<div class="absolute inset-0 z-0">
			<Image 
				src={backgroundHero} 
				alt="Tarapoto Background" 
				class="w-full h-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-black/45"></div>
		</div>

		{/* Contenido Hero - 3 filas de título */}
		<div class="relative z-10 flex flex-col justify-center pt-48 h-full px-12 md:px-24 max-w-5xl">
			<h1 class="leading-[1.15]">
				<span class="font-heading text-[48px] font-bold text-white block">
					Vive Tarapoto
				</span>
				<span class="font-heading text-[48px] font-bold text-white block">
					como se debe:
				</span>
				<span class="font-heading text-[48px] font-bold text-[#F4B13B] block">
					Sin complicaciones
				</span>
			</h1>

			<p class="font-body text-[20px] font-normal text-[#F3F2ED] mt-6 max-w-xl leading-relaxed">
				Tours, paquetes y experiencias listas para que solo te preocupes por disfrutar.
			</p>

			<div class="flex flex-wrap gap-5 mt-10">
				{/* Botón 1: Diseño igual al de Contáctanos */}
				<a href="#paquetes" class="bg-[#F4B13B] text-[#121110] px-10 py-3 rounded-md font-medium text-[16px] hover:brightness-105 transition-all flex items-center justify-center">
					Ver paquetes
				</a>

				{/* Botón 2: WhatsApp con blur y borde */}
				<a href="https://wa.me/..." target="_blank" class="border border-white bg-white/5 backdrop-blur-[5.3px] px-8 py-3 rounded-md font-action font-medium text-[18px] text-white flex items-center justify-center gap-3 hover:bg-white/10 transition-all">
					<img src={wspIcon.src} alt="WhatsApp" class="w-6 h-6" />
					Hablar por WhatsApp
				</a>
			</div>
		</div>
	</main>

	<section class="bg-[#F3F2ED] py-4 px-2 md:px-5">
		<div class="relative w-full">
			<Image 
				src={backgroundPromo} 
				alt="Promo Background" 
				class="w-full h-auto object-cover"
			/>
			{/* Overlay sutil para la imagen promo */}
			<div class="absolute inset-0 bg-black/5"></div>
		</div>
	</section>

	{/* ============================================================
	     Experiencias favoritas — carrusel de paquetes (desde Figma)
	     ============================================================ */}
	<section class="relative bg-[#F3F2ED] py-[70px] px-8 md:px-[100px] overflow-hidden">
		{/* Logo TPP como marca de agua decorativa (abajo-izquierda, muy tenue) */}
		<Image
			src={logoMarca}
			alt=""
			aria-hidden="true"
			class="pointer-events-none select-none absolute -left-24 -bottom-16 w-[640px] max-w-none opacity-[0.06] rotate-180 z-0"
		/>

		<div class="relative z-10 flex flex-col lg:flex-row gap-10 lg:gap-20 items-start">

			{/* Columna izquierda: título + descripción */}
			<div class="relative flex flex-col gap-4 shrink-0 w-full lg:w-[480px]">
				<div class="relative z-10 border-b border-[#F45A3B]/20 pb-6">
					{/* Etiqueta "LOS MÁS ELEGIDOS" */}
					<div class="inline-flex bg-[#F45A3B] -rotate-1 px-5 py-1.5 rounded-sm mb-3">
						<span class="font-body font-medium text-[20px] text-white">LOS MÁS ELEGIDOS</span>
					</div>
					<h2 class="font-heading font-bold text-[36px] leading-[0.95] text-[#191505]">
						Experiencias favoritas de nuestros viajeros
					</h2>
				</div>
				<p class="relative z-10 font-body text-[18px] text-[#121110]/80 leading-normal">
					Los paquetes, tours y alojamientos más reservados para descubrir Tarapoto.
				</p>
				<Image src={logoMarca} alt="" class="pointer-events-none select-none absolute -left-20 top-[50px] w-[680px] max-w-none z-0" />
			</div>

			{/* Columna derecha: flechas + carrusel de cards */}
			<div class="flex flex-1 gap-3.5 items-center min-w-0 w-full">
				<button
					type="button"
					data-carousel-prev
					class="opacity-50 hover:opacity-100 disabled:opacity-20 disabled:cursor-default transition-opacity shrink-0 text-[#121110] cursor-pointer"
					aria-label="Anterior"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>

				<div
					data-carousel-track
					class="flex flex-1 gap-3.5 items-stretch min-w-0 overflow-x-auto py-6 px-4 snap-x [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-w-[1120px]"
				>
					{[...paquetes, ...paquetes, ...paquetes].map((p) => (
						<article class="bg-white shadow-[0_4px_16px_rgba(34,32,30,0.12)] hover:shadow-[0_8px_24px_rgba(34,32,30,0.18)] transition-shadow flex flex-col gap-3.5 pb-2.5 pt-1.5 px-1.5 rounded-lg shrink-0 w-[248px] snap-start">
							{/* Imagen + tag + estrellas */}
							<div class="relative flex flex-col gap-2 h-[194px] items-center justify-end py-3.5 rounded-md overflow-hidden">
								<img src={p.imagen} alt={p.nombre} class="absolute inset-0 w-full h-full object-cover rounded-md" />
								{/* Overlay degradado oscuro */}
								<div class="absolute inset-0 rounded-md bg-gradient-to-b from-[rgba(4,22,20,0.72)] via-transparent to-[rgba(4,22,20,0.3)] mix-blend-multiply"></div>
								{/* Tag (esquina sup. izq.) */}
								<span class={`absolute top-[23px] left-0 px-3 py-1 text-[13px] font-body font-semibold uppercase ${p.tagClase}`} style="clip-path: polygon(0 0, 100% 0, 90% 100%, 0 100%);">
									{p.tag}
								</span>
								{/* Puntos indicadores del carrusel de fotos */}
								<div class="relative z-10 flex gap-1.5">
									<span class="w-2.5 h-2.5 rounded-full bg-[#F4B13B]"></span>
									<span class="w-2.5 h-2.5 rounded-full bg-white"></span>
									<span class="w-2.5 h-2.5 rounded-full bg-white"></span>
									<span class="w-2.5 h-2.5 rounded-full bg-white"></span>
								</div>
							</div>

							{/* Contenido */}
							<div class="flex flex-col px-1">
								<h3 class="font-heading font-semibold text-[16px] leading-[1.11] text-[#191505] text-center">
									{p.nombre}
								</h3>
								<div class="flex flex-col gap-[17px] pt-2.5">
									<div class="flex gap-2.5 items-end">
										<div class="flex flex-col text-center">
											<span class="font-price text-[12px] leading-[0.95] line-through opacity-70 text-[#121110]">{p.precioAntes}</span>
											<span class="font-price font-bold text-[18px] leading-[1.2] text-[#191505]">{p.precio}</span>
										</div>
										{p.descuento && (
											<span class="bg-[#cc140d] flex items-center justify-center px-2.5 py-1 rounded-full text-[12px] font-heading font-semibold text-white">
												{p.descuento}
											</span>
										)}
									</div>
									<button class="bg-[#d3d1c6] hover:brightness-95 transition-all flex gap-1.5 h-10 items-center justify-center px-6 rounded w-full cursor-pointer">
										<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2v16M2 10h16" stroke="#262522" stroke-width="2" stroke-linecap="round"/></svg>
										<span class="font-action font-medium text-[14px] text-[#262522]">Añadir a mi viaje</span>
									</button>
								</div>
							</div>
						</article>
					))}
				</div>

				<button
					type="button"
					data-carousel-next
					class="opacity-50 hover:opacity-100 disabled:opacity-20 disabled:cursor-default transition-opacity shrink-0 text-[#121110] cursor-pointer"
					aria-label="Siguiente"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
			</div>
		</div>
	</section>

	{/* Carrusel: flechas mueven el track con scroll suave de manera infinita */}
	<script>
		document.querySelectorAll('[data-carousel-track]').forEach((track) => {
			const el = track as HTMLElement;
			const wrap = el.parentElement!;
			const prev = wrap.querySelector('[data-carousel-prev]') as HTMLButtonElement;
			const next = wrap.querySelector('[data-carousel-next]') as HTMLButtonElement;

			const getCardWidth = () => {
				const card = el.querySelector('article');
				return card ? card.getBoundingClientRect().width + 14 : 262;
			};

			const totalItems = el.querySelectorAll('article').length;
			const originalCount = totalItems / 3;

			// Inicializar en el bloque central de elementos
			const initCarousel = () => {
				const step = getCardWidth();
				el.scrollLeft = originalCount * step;
			};

			// Ejecutar después de cargar
			setTimeout(initCarousel, 100);

			// Manejar scroll infinito y salto invisible al llegar a los extremos
			let isJumping = false;
			const handleScroll = () => {
				if (isJumping) return;
				const step = getCardWidth();
				const current = el.scrollLeft;
				
				// Límites para activar el salto (un poco antes de llegar a los bordes de los bloques clonados)
				const minLimit = (originalCount - 0.5) * step;
				const maxLimit = (originalCount * 2 - 0.5) * step;

				if (current < minLimit) {
					isJumping = true;
					el.style.scrollBehavior = 'auto'; // Desactiva scroll suave temporalmente
					el.scrollLeft = current + originalCount * step;
					// Forzar un reflujo para asegurar que el navegador aplique el cambio antes de reactivar el smooth
					el.getBoundingClientRect();
					el.style.scrollBehavior = 'smooth';
					isJumping = false;
				} else if (current > maxLimit) {
					isJumping = true;
					el.style.scrollBehavior = 'auto'; // Desactiva scroll suave temporalmente
					el.scrollLeft = current - originalCount * step;
					// Forzar un reflujo
					el.getBoundingClientRect();
					el.style.scrollBehavior = 'smooth';
					isJumping = false;
				}
			};

			prev?.addEventListener('click', () => {
				el.style.scrollBehavior = 'smooth';
				el.scrollBy({ left: -getCardWidth() });
			});
			next?.addEventListener('click', () => {
				el.style.scrollBehavior = 'smooth';
				el.scrollBy({ left: getCardWidth() });
			});

			el.addEventListener('scroll', handleScroll, { passive: true });
			window.addEventListener('resize', initCarousel);
		});
	</script>
</Layout>
