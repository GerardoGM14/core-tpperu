---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Text from '../components/Text.astro';
import { Image } from 'astro:assets';
import backgroundHero from '../assets/background.webp';
import backgroundPromo from '../assets/background-promo.webp';
import wspIcon from '../icons/icon-wsp.svg';
import logoMarca from '../assets/logo_tpperu.png';
import experienciasBg from '../assets/experiencias-bg.png';
import disfrutaBg from '../assets/disfruta-bg.png';
import disfrutaFoto1 from '../assets/disfruta-foto1.png';
import disfrutaFoto2 from '../assets/disfruta-foto2.png';
import asifacilBg from '../assets/asifacil-bg.png';
import asifacilCamino from '../assets/asifacil-camino.svg';
import porqueBg from '../assets/porque-bg.png';
import porqueFoto1 from '../assets/porque-foto1.png';
import porqueFoto2 from '../assets/porque-foto2.png';
import vive1 from '../assets/vive-1.png';
import vive2 from '../assets/vive-2.png';
import vive3 from '../assets/vive-3.png';
import vive4 from '../assets/vive-4.png';
import vive5 from '../assets/vive-5.png';
import vive6 from '../assets/vive-6.png';
import vive7 from '../assets/vive-7.png';
import vive8 from '../assets/vive-8.png';
import contactoBg from '../assets/contacto-bg.png';
import libroReclamaciones from '../assets/libro-reclamaciones.png';
import pagoVisa from '../assets/pago-visa.png';
import pagoMaster from '../assets/pago-master.png';
import pago3 from '../assets/pago-3.png';
import hojaIzq from '../assets/hoja-izq.svg';
import logoTppFooter from '../assets/logo-tpp-footer.png';
import banderinVive from '../assets/banderin-vive.svg';

// ============================================================
//  Paquetes destacados — EDITA AQUÍ tus datos reales
//  tagClase: clases de color del tag según tipo
//    naranja → 'bg-[#f26304] text-white'
//    amarillo → 'bg-[#f4b13b] text-[#121110]'
//    rojo     → 'bg-[#cc140d] text-white'
//  imagen: reemplaza la URL por un import de ../assets/ cuando tengas las fotos
// ============================================================
const paquetes = [
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Imperdibles',
		tagClase: 'bg-[#f26304] text-white',
		imagen: 'https://images.unsplash.com/photo-1531168556467-80aace0d0144?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Nuevo',
		tagClase: 'bg-[#f4b13b] text-[#121110]',
		imagen: 'https://images.unsplash.com/photo-1544735716-392fe2489ffa?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Cyber',
		tagClase: 'bg-[#cc140d] text-white',
		imagen: 'https://images.unsplash.com/photo-1437846972679-9e6e537be46e?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Imperdibles',
		tagClase: 'bg-[#f26304] text-white',
		imagen: 'https://images.unsplash.com/photo-1518182170546-07661fd94144?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Nuevo',
		tagClase: 'bg-[#f4b13b] text-[#121110]',
		imagen: 'https://images.unsplash.com/photo-1472396961693-142e6e269027?w=500&q=80',
	},
	{
		nombre: 'Paquete Tarapoto 7d/6n con una noche en Laguna',
		precio: 'S/ 589',
		precioAntes: 'S/829',
		descuento: '-45%',
		tag: 'Cyber',
		tagClase: 'bg-[#cc140d] text-white',
		imagen: 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=500&q=80',
	},
];

// ============================================================
//  Sección "Explora todas nuestras opciones"
//  3 bloques de carrusel. Solo "Paquetes" tiene filtros.
//  cards: reutiliza el mismo array de ejemplo (edita por bloque cuando tengas datos reales).
// ============================================================
const bloquesExplora = [
	{
		titulo: 'Paquetes',
		subtitulo: 'Viajes completos sin complicaciones',
		verTodos: 'Ver todos los Paquetes',
		filtros: ['Tarapoto', 'Tarapoto Económico', 'Internacional'],
		cards: paquetes,
	},
	{
		titulo: 'Tours',
		subtitulo: 'Experiencias de un día para explorar',
		verTodos: 'Ver todos los Tours',
		filtros: null,
		cards: paquetes,
	},
	{
		titulo: 'Alojamientos',
		subtitulo: 'Descanso en medio de la naturaleza',
		verTodos: 'Ver todos los Alojamientos',
		filtros: null,
		cards: paquetes,
	},
];

// ============================================================
//  Sección "Disfruta el viaje" — beneficios (icono SVG inline + título + texto)
// ============================================================
const beneficios = [
	{
		titulo: 'Itinerario claro',
		texto: 'Sabrás exactamente qué harás en cada momento de tu viaje.',
		icono: '<path d="M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
	},
	{
		titulo: 'Horarios definidos',
		texto: 'Sin improvisaciones ni confusiones, todo está coordinado.',
		icono: '<circle cx="12" cy="12" r="9" stroke="white" stroke-width="2" fill="none"/><path d="M12 7v5l3 3" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
	},
	{
		titulo: 'Guía asignado',
		texto: 'Acompañamiento durante tu experiencia para que aproveches al máximo.',
		icono: '<circle cx="12" cy="8" r="4" stroke="white" stroke-width="2" fill="none"/><path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>',
	},
	{
		titulo: 'Información antes del viaje',
		texto: 'Recibe todos los detalles necesarios antes de empezar.',
		icono: '<rect x="5" y="3" width="14" height="18" rx="2" stroke="white" stroke-width="2" fill="none"/><path d="M9 8h6M9 12h6M9 16h4" stroke="white" stroke-width="2" stroke-linecap="round"/>',
	},
];

// ============================================================
//  Sección "Así de fácil es viajar con nosotros" — 4 pasos sobre un camino
//  marginTop: desfase vertical de cada cartel (replica el zig-zag del diseño)
// ============================================================
const pasos = [
	{ texto: 'Elige tu experiencia',     marginTop: '120px', rotate: '0deg' },
	{ texto: 'Reserva fácilmente',       marginTop: '58px',  rotate: '0deg' },
	{ texto: 'Recibe todos los detalles', marginTop: '105px', rotate: '-2deg' },
	{ texto: 'Disfruta cada momento',    marginTop: '8px',   rotate: '3.7deg' },
];

// ============================================================
//  Sección "¿Por qué elegirnos?" — 5 razones
// ============================================================
const razones = [
	{ titulo: 'Atención rápida por WhatsApp',            texto: 'Te respondemos cuando lo necesitas.' },
	{ titulo: 'Información clara y actualizada',          texto: 'Te explicamos todo fácil, sin enredos.' },
	{ titulo: 'Acompañamiento antes y durante tu viaje', texto: 'Te acompañamos en cada paso.' },
	{ titulo: 'Agencia registrada en MINCETUR',          texto: 'Viajas con una agencia formal y confiable.' },
	{ titulo: 'Reconocimiento en buenas prácticas de CALTUR', texto: 'Nos tomamos en serio tu experiencia.' },
];

// ============================================================
//  Sección "Así se vive Tarapoto" — galería (8 fotos a distintas alturas)
//  align: posición vertical de cada foto en la fila (start / center / end)
// ============================================================
const galeriaVive = [
	{ img: vive1, w: '339px', align: 'items-start' },
	{ img: vive2, w: '228px', align: 'items-end' },
	{ img: vive3, w: '205px', align: 'items-start' },
	{ img: vive4, w: '380px', align: 'items-end' },
	{ img: vive5, w: '242px', align: 'items-start' },
	{ img: vive6, w: '382px', align: 'items-end' },
	{ img: vive7, w: '228px', align: 'items-start' },
	{ img: vive8, w: '239px', align: 'items-end' },
];
---

<Layout title="TPP PERÚ | Vive Tarapoto">
	<Navbar />
	
	<main class="relative h-screen min-h-[800px] overflow-hidden">
		{/* Imagen de fondo con overlay */}
		<div class="absolute inset-0 z-0">
			<Image 
				src={backgroundHero} 
				alt="Tarapoto Background" 
				class="w-full h-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-black/45"></div>
		</div>

		{/* Contenido Hero - 3 filas de título */}
		<div class="relative z-10 flex flex-col justify-center pt-48 h-full px-12 md:px-24 max-w-5xl">
			<h1 class="leading-[1.15]">
				<span class="font-heading text-[48px] font-bold text-white block">
					Vive Tarapoto
				</span>
				<span class="font-heading text-[48px] font-bold text-white block">
					como se debe:
				</span>
				<span class="font-heading text-[48px] font-bold text-[#F4B13B] block">
					Sin complicaciones
				</span>
			</h1>

			<p class="font-body text-[20px] font-normal text-[#F3F2ED] mt-6 max-w-xl leading-relaxed">
				Tours, paquetes y experiencias listas para que solo te preocupes por disfrutar.
			</p>

			<div class="flex flex-wrap gap-5 mt-10">
				{/* Botón 1: Diseño igual al de Contáctanos */}
				<a href="#paquetes" class="bg-[#F4B13B] text-[#121110] px-10 py-3 rounded-md font-medium text-[16px] hover:brightness-105 transition-all flex items-center justify-center">
					Ver paquetes
				</a>

				{/* Botón 2: WhatsApp con blur y borde */}
				<a href="https://wa.me/..." target="_blank" class="border border-white bg-white/5 backdrop-blur-[5.3px] px-8 py-3 rounded-md font-action font-medium text-[18px] text-white flex items-center justify-center gap-3 hover:bg-white/10 transition-all">
					<img src={wspIcon.src} alt="WhatsApp" class="w-6 h-6" />
					Hablar por WhatsApp
				</a>
			</div>
		</div>
	</main>

	<section class="bg-[#F3F2ED] py-4 px-2 md:px-5">
		<div class="relative w-full">
			<Image 
				src={backgroundPromo} 
				alt="Promo Background" 
				class="w-full h-auto object-cover"
			/>
			{/* Overlay sutil para la imagen promo */}
			<div class="absolute inset-0 bg-black/5"></div>
		</div>
	</section>

	{/* ============================================================
	     Experiencias favoritas — carrusel de paquetes (desde Figma)
	     ============================================================ */}
	<section class="relative bg-[#F3F2ED] py-[70px] px-8 md:px-[100px] overflow-hidden">
		{/* Logo TPP como marca de agua decorativa (abajo-izquierda, dentro de la sección).
		    Se pinta con máscara CSS para tener color dorado sólido (sin lavado de filtros). */}
		<div
			aria-hidden="true"
			class="pointer-events-none select-none absolute left-2 -bottom-12 w-[560px] h-[440px] opacity-80 z-0 bg-[#f26304]"
			style={`mask: url(${logoMarca.src}) bottom left / contain no-repeat; -webkit-mask: url(${logoMarca.src}) bottom left / contain no-repeat;`}
		></div>

		<div class="relative z-10 flex flex-col lg:flex-row gap-10 items-start">

			{/* Columna izquierda: título + descripción */}
			<div class="flex flex-col gap-4 shrink-0 w-full lg:w-[386px]">
				<div class="border-b border-[#F45A3B]/20 pb-6">
					{/* Etiqueta "LOS MÁS ELEGIDOS" */}
					<div class="inline-flex bg-[#F45A3B] -rotate-1 px-5 py-1.5 rounded-sm mb-3">
						<span class="font-body font-medium text-[20px] text-white">LOS MÁS ELEGIDOS</span>
					</div>
					<h2 class="font-heading font-bold text-[36px] leading-[0.95] text-[#191505]">
						Experiencias favoritas de nuestros viajeros
					</h2>
				</div>
				<p class="font-body text-[18px] text-[#121110]/80 leading-normal">
					Los paquetes, tours y alojamientos más reservados para descubrir Tarapoto.
				</p>
			</div>

			{/* Columna derecha: flechas + carrusel de cards */}
			<div class="flex flex-1 gap-3.5 items-center min-w-0 w-full">
				<button
					type="button"
					data-carousel-prev
					class="opacity-50 hover:opacity-100 disabled:opacity-20 disabled:cursor-default transition-opacity shrink-0 text-[#121110] cursor-pointer"
					aria-label="Anterior"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>

				<div
					data-carousel-track
					class="flex flex-1 gap-6 items-stretch min-w-0 overflow-x-auto px-3 py-5 -mx-3 -my-5 scroll-smooth snap-x [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
				>
					{paquetes.map((p) => (
						<article class="bg-white shadow-[0_6px_20px_-2px_rgba(34,32,30,0.18)] hover:shadow-[0_12px_28px_-4px_rgba(34,32,30,0.25)] transition-shadow flex flex-col gap-3.5 pb-2.5 pt-1.5 px-1.5 rounded-lg shrink-0 w-[248px] snap-start">
							{/* Imagen + tag + estrellas */}
							<div class="relative flex flex-col gap-2 h-[194px] items-center justify-end py-3.5 rounded-md overflow-hidden">
								<img src={p.imagen} alt={p.nombre} class="absolute inset-0 w-full h-full object-cover rounded-md" />
								{/* Overlay degradado oscuro */}
								<div class="absolute inset-0 rounded-md bg-gradient-to-b from-[rgba(4,22,20,0.72)] via-transparent to-[rgba(4,22,20,0.3)] mix-blend-multiply"></div>
								{/* Tag (esquina sup. izq.) */}
								<span class={`absolute top-[23px] left-0 px-3 py-1 text-[13px] font-body font-semibold uppercase ${p.tagClase}`} style="clip-path: polygon(0 0, 100% 0, 90% 100%, 0 100%);">
									{p.tag}
								</span>
								{/* Estrellas / rating (placeholder) */}
								<div class="relative z-10 flex gap-1 text-[#F4B13B] text-[8px]">
									★★★★★
								</div>
							</div>

							{/* Contenido */}
							<div class="flex flex-col px-1">
								<h3 class="font-heading font-semibold text-[16px] leading-[1.11] text-[#191505] text-center">
									{p.nombre}
								</h3>
								<div class="flex flex-col gap-[17px] pt-2.5">
									<div class="flex gap-2.5 items-end">
										<div class="flex flex-col text-center">
											<span class="font-price text-[12px] leading-[0.95] line-through opacity-70 text-[#121110]">{p.precioAntes}</span>
											<span class="font-price font-bold text-[18px] leading-[1.2] text-[#191505]">{p.precio}</span>
										</div>
										{p.descuento && (
											<span class="bg-[#cc140d] flex items-center justify-center px-2.5 py-1 rounded-full text-[12px] font-heading font-semibold text-white">
												{p.descuento}
											</span>
										)}
									</div>
									<button class="bg-[#d3d1c6] hover:brightness-95 transition-all flex gap-1.5 h-10 items-center justify-center px-6 rounded w-full cursor-pointer">
										<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2v16M2 10h16" stroke="#262522" stroke-width="2" stroke-linecap="round"/></svg>
										<span class="font-action font-medium text-[14px] text-[#262522]">Añadir a mi viaje</span>
									</button>
								</div>
							</div>
						</article>
					))}
				</div>

				<button
					type="button"
					data-carousel-next
					class="opacity-50 hover:opacity-100 disabled:opacity-20 disabled:cursor-default transition-opacity shrink-0 text-[#121110] cursor-pointer"
					aria-label="Siguiente"
				>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
			</div>
		</div>
	</section>

	{/* ============================================================
	     Explora todas nuestras opciones — 3 carruseles sobre fondo selva (desde Figma)
	     ============================================================ */}
	<section class="relative overflow-hidden bg-[#191505] pt-[100px] pb-[120px] px-8 md:px-[100px]">
		{/* Fondo: imagen selva en el 44% superior + degradado hacia #191505 */}
		<div aria-hidden="true" class="absolute inset-0 pointer-events-none z-0">
			<Image src={experienciasBg} alt="" class="absolute top-0 left-[-2%] w-[104%] h-[44%] max-w-none object-cover" />
			<div class="absolute inset-0 bg-gradient-to-b from-[rgba(25,21,5,0.71)] from-[6%] to-[#191505] to-[40%]"></div>
		</div>

		{/* Header decorativo */}
		<div class="relative z-10 flex flex-col items-center mb-[71px]">
			<div class="flex flex-col items-center text-center leading-[0.95]">
				<p class="font-decoration text-[48px] text-[#f4b13b] -mb-2">Explora todas</p>
				<p class="font-heading font-bold text-[36px] text-white">nuestras opciones</p>
			</div>
			{/* Badge "Vive · Explora · Disfruta" (amarillo, ligeramente rotado) */}
			<div class="mt-3 -rotate-2 bg-[#f4b13b] rounded-full px-6 py-1.5">
				<span class="font-body font-medium text-[20px] text-[#121110]">Vive · Explora · Disfruta</span>
			</div>
		</div>

		{/* Bloques de carrusel */}
		<div class="relative z-10 flex flex-col gap-[86px]">
			{bloquesExplora.map((bloque) => (
				<div class="flex gap-[25px] items-start">
					{/* Diamante decorativo dorado (rombo) */}
					<div class="shrink-0 size-[33px] rotate-45 bg-[rgba(244,177,59,0.13)] flex items-center justify-center mt-1">
						<div class="size-[10px] bg-[#f4b13b]"></div>
					</div>

					<div class="flex flex-1 flex-col gap-10 min-w-0">
					{/* Encabezado del bloque: título + subtítulo + (filtros) + ver todos */}
					<div class="flex flex-col gap-9">
						<div class="flex flex-col">
							<p class="font-decoration text-[32px] text-[#f4b13b] leading-[0.95]">{bloque.titulo}</p>
							<p class="font-body text-[20px] text-[#f3f2ed]">{bloque.subtitulo}</p>
						</div>
						<div class="flex items-end justify-between gap-4 md:px-10 flex-wrap">
							{/* Filtros (solo Paquetes) */}
							{bloque.filtros ? (
								<div class="flex gap-3 items-center flex-wrap">
									{bloque.filtros.map((filtro, i) => (
										i === 0 ? (
											<button type="button" class="h-10 px-6 rounded-full bg-[#f4b13b] font-action font-medium text-[16px] text-[#121110] cursor-pointer">{filtro}</button>
										) : (
											<button type="button" class="h-10 px-6 rounded-full border border-white bg-white/[0.02] backdrop-blur-[2.65px] font-action font-medium text-[16px] text-white hover:bg-white/10 transition-colors cursor-pointer">{filtro}</button>
										)
									))}
								</div>
							) : <div></div>}
							{/* Ver todos */}
							<button type="button" class="font-action font-medium text-[18px] text-[#f4b13b] hover:underline cursor-pointer whitespace-nowrap">{bloque.verTodos}</button>
						</div>
					</div>

					{/* Carrusel del bloque */}
					<div class="flex gap-3.5 items-center min-w-0 w-full">
						<button type="button" data-carousel-prev class="opacity-60 hover:opacity-100 disabled:opacity-20 disabled:cursor-default transition-opacity shrink-0 text-white cursor-pointer" aria-label="Anterior">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>

						<div data-carousel-track data-carousel-infinite class="flex flex-1 gap-6 items-stretch min-w-0 overflow-x-auto px-3 py-5 -mx-3 -my-5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
							{bloque.cards.map((p) => (
								<article class="bg-white shadow-[0_6px_20px_-2px_rgba(0,0,0,0.4)] hover:shadow-[0_12px_28px_-4px_rgba(0,0,0,0.55)] transition-shadow flex flex-col gap-3.5 pb-2.5 pt-1.5 px-1.5 rounded-lg shrink-0 w-[248px] snap-start">
									<div class="relative flex flex-col gap-2 h-[194px] items-center justify-end py-3.5 rounded-md overflow-hidden">
										<img src={p.imagen} alt={p.nombre} class="absolute inset-0 w-full h-full object-cover rounded-md" />
										<div class="absolute inset-0 rounded-md bg-gradient-to-b from-[rgba(4,22,20,0.72)] via-transparent to-[rgba(4,22,20,0.3)] mix-blend-multiply"></div>
										<span class={`absolute top-[23px] left-0 px-3 py-1 text-[13px] font-body font-semibold uppercase ${p.tagClase}`} style="clip-path: polygon(0 0, 100% 0, 90% 100%, 0 100%);">
											{p.tag}
										</span>
										<div class="relative z-10 flex gap-1 text-[#F4B13B] text-[8px]">★★★★★</div>
									</div>
									<div class="flex flex-col px-1">
										<h3 class="font-heading font-semibold text-[16px] leading-[1.11] text-[#191505] text-center">{p.nombre}</h3>
