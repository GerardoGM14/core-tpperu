# ============================================================
# wa-daemon - Environment configuration
# ============================================================

PORT=8080

# DB para whatsmeow sqlstore (Postgres)
# Mismo Postgres que la API; whatsmeow crea sus tablas whatsmeow_*
DATABASE_URL=postgres://tpp:tpp_dev_password@localhost:5432/tpp?sslmode=disable

# Redis para pub/sub con la API
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Canales pub/sub (deben coincidir con la API)
CHANNEL_INBOUND=whatsapp:inbound
CHANNEL_QR=whatsapp:qr
CHANNEL_STATUS=whatsapp:status

# Etiqueta de la sesión (por si en el futuro hay multi-número)
SESSION_LABEL=default

# Log level: debug | info | warn | error
LOG_LEVEL=info
