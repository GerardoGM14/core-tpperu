# ============================================================
# TPP API - Environment configuration
# Copiar a .env y rellenar valores. NO commitear .env real.
# ============================================================

NODE_ENV=development
PORT=4000

# Frontend permitido por CORS (Firebase Hosting en prod)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://tpp:tpp_dev_password@127.0.0.1:5432/tpp?schema=public

# Redis (BullMQ + pub/sub con wa-daemon)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
JWT_REFRESH_SECRET=cambia-esto-tambien-y-distinto-al-de-arriba
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# wa-daemon (Go + whatsmeow)
WA_DAEMON_URL=http://localhost:8080
WA_REDIS_CHANNEL_INBOUND=whatsapp:inbound
WA_REDIS_CHANNEL_QR=whatsapp:qr
WA_REDIS_CHANNEL_STATUS=whatsapp:status

# Email (Gmail SMTP). Si SMTP_USER/SMTP_PASS están vacíos, el envío de
# correos se desactiva (las reservas se guardan igual, sin enviar email).
# SMTP_PASS es una "contraseña de aplicación" de Google, NO la del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinatario interno (a dónde llega el aviso de nueva reserva)
RESERVATIONS_EMAIL=
